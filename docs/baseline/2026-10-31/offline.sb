(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath "/Users/d"))
(allow file-read-metadata (subpath "/Users/d"))
(allow file-read* (literal "/Users/d") (literal "/Users/d/Tools"))
(allow file-read* (subpath "/Users/d/Tools/clink-mcp-server"))
(deny file-write* (subpath "/Users/d"))
(allow file-write* (subpath "/Users/d/Tools/clink-mcp-server"))
