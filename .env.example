# clink-mcp-server optional server settings.
# Copy to .env only if needed; the launcher never creates or refreshes it.
# Native CLIs own authentication. Do not put provider credentials here.

# Default configured client; the default role is "default".
CLINK_DEFAULT_CLI=codex

# Positive integer. Queue capacity and request deadlines remain bounded.
CLINK_MAX_CONCURRENT=2

# Optional highest-priority manifest source: one JSON file or a directory.
# See docs/cli-configuration.md; each client replaces the whole lower-priority client.
# CLI_CLIENTS_CONFIG_PATH=/absolute/path/to/cli_clients

# All 18 tools are enabled. Comma-separated names disable selected tools.
# version and listmodels remain available.
DISABLED_TOOLS=

# In-memory continuations are lost on restart. Limits count individual messages.
CONVERSATION_TIMEOUT_HOURS=3
MAX_CONVERSATION_TURNS=50

# Native model identifiers belong in client default_model or role model fields.
# DEFAULT_MODEL is deprecated; temperature/thinking_mode have no native mapping.
# DEFAULT_THINKING_MODE_THINKDEEP is retained for compatibility only.

LOG_LEVEL=INFO
# LOCALE=fr-FR
# MAX_MCP_OUTPUT_TOKENS=20000

# Retained compatibility name. false preserves environment-over-.env precedence.
# true makes get_env() use only .env values/defaults; omitted keys do not use
# process environment values. Child CLI environment filtering is separate.
PAL_MCP_FORCE_ENV_OVERRIDE=false

# Deployment settings; LOG_MAX_SIZE applies only to container tooling that reads it.
# Python log rotation is configured in server.py.
COMPOSE_PROJECT_NAME=clink-mcp
TZ=UTC
LOG_MAX_SIZE=10MB
